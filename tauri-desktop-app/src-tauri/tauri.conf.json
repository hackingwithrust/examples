{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustnote",
  "version": "1.0.0",
  "identifier": "com.rustnote.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rustnote",
        "width": 960,
        "height": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFOTBDN0Q4OTZCRUI4OUQKUldTZHVMNlcyTWVRZmxaS3p2RDY5NGNPQS8rWmRyZ28rN1crVndBSHJOZGJSTXFPMVdHMVFybGwK",
      "endpoints": [
        "https://rustnote-updates.example.com/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
